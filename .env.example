# MIT Parley — OpenAI-compatible (https://parley-docs.mit.edu/). Any OpenAI-compatible endpoint works.
OPENAI_BASE_URL=https://parley.api.mit.edu/v1
OPENAI_API_KEY=
# Model id as listed by GET $OPENAI_BASE_URL/models
OPENAI_MODEL=
# responses (OpenAI models; honours reasoning effort) | chat (Chat Completions; other providers, e.g. Gemini, Claude, Llama)
OPENAI_API=responses
# Reasoning effort: none | minimal | low | medium | high (none for models without reasoning, e.g. Llama)
OPENAI_REASONING_EFFORT=medium
# Optional LangSmith tracing of every model call made through /api/llm (server-side only)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mbta-gtfs-agent

# Optional HTTP Basic Auth for public deployments (both must be set to enable)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
